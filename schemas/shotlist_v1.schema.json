{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShotList v1",
  "description": "Visual composition per beat — the shot list the Visual Director emits.",
  "type": "object",
  "required": ["version", "shots"],
  "properties": {
    "version": {"type": "string", "const": "v1"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/Shot"}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "topic": {"type": "string"},
        "total_duration": {"type": "number", "minimum": 0},
        "style_spec_used": {"type": "string"}
      }
    }
  },
  "definitions": {
    "Shot": {
      "type": "object",
      "required": ["shot_id", "beat_id", "visual_type", "renderer", "objects"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
        "beat_id": {"type": "string", "pattern": "^b[0-9]{3}$"},
        "visual_type": {"type": "string"},
        "renderer": {"type": "string", "enum": ["manim", "media", "vector"]},
        "duration": {"type": "number", "minimum": 0.1},
        "objects": {
          "type": "array",
          "items": {"$ref": "#/definitions/Object"}
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "#/definitions/Action"}
        },
        "camera": {"$ref": "#/definitions/Camera"},
        "emphasis": {"type": "array", "items": {"type": "string"}},
        "audio_cues": {
          "type": "array",
          "items": {"$ref": "#/definitions/AudioCue"}
        }
      },
      "additionalProperties": false
    },
    "Object": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["digit_array", "number_display", "equation", "fraction", "matrix", "graph", "vector", "shape", "text", "number"]
        },
        "value": {"type": "string"},
        "position": {
          "type": "object",
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
        }
      },
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["reorder", "morph", "move", "highlight", "write", "draw", "transform", "subtract", "sort", "multiply", "swap", "reverse", "digit_permute", "count_down", "converge", "orbital", "reveal"]
        },
        "from": {},
        "to": {},
        "mode": {"type": "string"},
        "relative_time": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "Camera": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["static", "follow", "zoom_to", "zoom_from", "pan", "push_in", "pull_out", "reveal", "reframe", "focus"]
        },
        "target": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AudioCue": {
      "type": "object",
      "required": ["type", "relative_time"],
      "properties": {
        "type": {"type": "string", "enum": ["tick", "click", "whoosh", "impact", "reveal", "transition", "success", "failure", "rise", "pop", "ambient"]},
        "relative_time": {"type": "number", "minimum": 0, "maximum": 1},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
