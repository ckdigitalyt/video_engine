{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualSpec v1",
  "description": "The semantic visual specification — the strict JSON contract DeepSeek emits and the deterministic compiler turns into Manim.  DeepSeek decides WHAT/WHY/WHEN; the trusted renderer decides HOW.",
  "type": "object",
  "required": ["version", "beats"],
  "properties": {
    "version": {"type": "string", "const": "v1"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/VisualBeat"}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "topic": {"type": "string"},
        "style_spec": {"type": "string"}
      }
    }
  },
  "definitions": {
    "VisualBeat": {
      "type": "object",
      "required": ["beat_id", "intent", "objects", "transformations"],
      "properties": {
        "beat_id": {"type": "string", "pattern": "^b[0-9]{3}$"},
        "narration": {"type": "string"},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0.1},
        "intent": {"type": "string"},
        "importance": {"type": "string", "enum": ["high", "medium", "low"]},
        "objects": {
          "type": "array",
          "items": {"$ref": "#/definitions/ObjectSpec"}
        },
        "transformations": {
          "type": "array",
          "items": {"$ref": "#/definitions/Transformation"}
        },
        "camera": {"$ref": "#/definitions/CameraSpec"},
        "audio_cues": {
          "type": "array",
          "items": {"$ref": "#/definitions/AudioCue"}
        },
        "kinetic_words": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Narration words that should get visual emphasis"
        }
      },
      "additionalProperties": false
    },
    "ObjectSpec": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["digit_array", "number_display", "equation", "fraction", "matrix", "graph", "vector", "shape", "text", "number"]
        },
        "value": {"type": "string"},
        "initial": {"type": "string"},
        "initial_state": {"type": "object"},
        "position": {
          "type": "object",
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
        },
        "persistent": {"type": "boolean", "default": true},
        "kinetic_typography": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "Transformation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sort", "reverse", "subtract", "morph", "move", "highlight", "reveal", "transform", "digit_permute", "swap", "multiply", "count_down", "converge", "orbital"]
        },
        "targets": {"type": "array", "items": {"type": "string"}},
        "target_objects": {"type": "array", "items": {"type": "string"}},
        "from": {},
        "to": {},
        "mode": {"type": "string"},
        "params": {"type": "object"},
        "parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "CameraSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["static", "follow", "zoom_to", "zoom_from", "pan", "push_in", "pull_out", "reveal", "reframe", "focus"]
        },
        "target": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AudioCue": {
      "type": "object",
      "required": ["type", "relative_time"],
      "properties": {
        "type": {"type": "string", "enum": ["tick", "click", "whoosh", "impact", "reveal", "transition", "success", "failure", "rise", "pop"]},
        "relative_time": {"type": "number", "minimum": 0, "maximum": 1},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
