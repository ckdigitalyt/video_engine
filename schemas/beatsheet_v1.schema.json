{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BeatSheet v1",
  "description": "Defines the timing and narrative structure of a video as a sequence of beats.",
  "type": "object",
  "required": ["version", "beats"],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Beat"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "topic": {"type": "string"},
        "duration": {"type": "number", "minimum": 1.0},
        "target_audience": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "definitions": {
    "Beat": {
      "type": "object",
      "required": ["beat_id", "start", "end", "narration", "intent"],
      "properties": {
        "beat_id": {
          "type": "string",
          "pattern": "^b[0-9]{3}$"
        },
        "start": {
          "type": "number",
          "minimum": 0.0,
          "description": "Absolute start time in seconds"
        },
        "end": {
          "type": "number",
          "minimum": 0.0,
          "description": "Absolute end time in seconds"
        },
        "duration": {
          "type": "number",
          "minimum": 0.1,
          "description": "Calculated duration (end - start)"
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "intent": {
          "type": "string",
          "enum": [
            "hook", "tension", "discovery", "reveal", "explanation",
            "demonstrate_transformation", "demonstrate_arithmetic",
            "show_convergence", "pose_question", "build_intuition"
          ]
        },
        "importance": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "objects": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of object IDs that participate in this beat"
        },
        "visual_change_required": {
          "type": "boolean",
          "default": true
        },
        "audio_cues": {
          "type": "array",
          "items": {"$ref": "#/definitions/AudioCue"}
        },
        "qa_checks": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "AudioCue": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tick", "click", "whoosh", "impact", "reveal", "transition", "success", "failure", "rise", "pop", "ambient"]
        },
        "relative_time": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
